# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~

# Python
__pycache__/
*.pyc

# Virtual environment
.venv/

# Node
node_modules/

# Build artifacts (regenerated from scripts)
# Don't ignore - data/ is committed as source of truth

# Secrets — never commit
.env
.env.*
!.env.example

# Generated build outputs — rebuilt by scripts/build.py, never committed
_site/
pages/
print/
data/change-report.json
data/csv-by-county/

# data/resources.json and related public data files ARE committed —
# they are the source of truth for the live site. GitHub Pages serves
# them directly without a build step, eliminating the class of 404 bugs
# caused by CI failing to generate them at deploy time.

# Temporary discovery runs (durable queue is operations/leads/)
leads/runs/
