# Beacon environment — copy to .env and fill in values

# US Census Bureau API key (free at https://api.census.gov/data/key_signup.html)
# Used by data/census/census_indicators.py and needs scoring
CENSUS_API_KEY=

# SearXNG base URL for lead research scripts
# Default for local dev; override if SearXNG runs elsewhere
SEARXNG_URL=http://localhost:8888

# LiteLLM proxy for AI inference (optional — only needed for automated research)
LITELLM_BASE_URL=
LITELLM_MASTER_KEY=
